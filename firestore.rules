rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /fountains/{fountainId} {
      allow read: if true;
      allow write: if false; // admin SDK only via seed script
    }
    match /submissions/{submissionId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.authorUid;
    }
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.authorUid;
    }
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Saved fountains — a user may only read/write their own favorites.
      match /favorites/{fountainId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}

# Firebase Web App Config
# Copy this file to .env.local and fill in your project's values.
# Never commit .env or .env.local — they are in .gitignore.
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Open-Meteo (weather/UV data) — no API key required; it is a free, open API.

# Gemini AI (hydration tips) — SERVER-SIDE ONLY.
# Read exclusively by the /api/hydrate Vercel serverless function via
# process.env.GEMINI_API_KEY. Set it in the Vercel project's Environment
# Variables (Production + Preview), NOT in client .env files.
# WARNING: never prefix this with VITE_ — Vite inlines VITE_* vars into the
# public browser bundle, which would leak the key. Never commit a real key.
GEMINI_API_KEY=

# Seed script (Admin SDK) — set this to the path of your downloaded service-account key.
# Example:
#   GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
#   node scripts/seed.js
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
